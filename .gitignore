# Default deny at repository root; publish only reviewed code/docs/aggregate evidence.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CITATION.cff
!/pyproject.toml
!/src/
!/legacy/
!/docs/
!/environment/
!/tests/
!/scripts/
!/results/
!/.github/

# Data and local state remain excluded even under allowed directories.
**/.env
**/.env.*
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/*.duckdb*
**/*.parquet
**/*.csv
**/*.tsv
**/*.jsonl
**/*.ndjson
**/*.rds
**/*.RData
**/*.zip
**/*.gz
**/*.tar
**/*.pdf
**/*.docx
**/*.xlsx
**/*.pem
**/*.key
**/credentials*
**/data/
**/raw/
**/parquet/
**/.local/
**/execution.log
